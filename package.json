{
  "name": "@kk2a/blog-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate-ids": "tsx scripts/generate-ids.ts",
    "create-mdx": "tsx scripts/create-mdx.ts",
    "validate-mdx": "tsx scripts/validate-mdx.ts",
    "content:export": "tsx scripts/export-content-sql.ts",
    "predev": "pnpm generate-ids",
    "dev": "next dev",
    "prebuild": "pnpm generate-ids",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "lint:eslint": "eslint .",
    "types": "wrangler types apps/api/src/worker-configuration.d.ts --config wrangler.jsonc",
    "types:check": "wrangler types apps/api/src/worker-configuration.d.ts --config wrangler.jsonc --check",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm --filter @kk2a/blog-api test",
    "check": "pnpm types && pnpm types:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter @kk2a/blog-api typecheck && pnpm validate-mdx && pnpm test",
    "deploy": "pnpm build && pnpm --filter @kk2a/blog-api db:migrate:remote && pnpm exec wrangler deploy",
    "predeploy": "pnpm generate-ids",
    "preview": "pnpm build && pnpm exec wrangler dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.4.6",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@tailwindcss/typography": "^0.5.16",
    "@types/mdx": "^2.0.13",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.539.0",
    "next": "^16.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-katex": "^3.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/workers-types": "^4.20250813.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-katex": "^3.0.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.30.0"
  },
  "lint-staged": {
    "content/**/*.mdx": [
      "npx tsx scripts/update-mdx-metadata.ts"
    ]
  }
}
