{
  "name": "@kk2a/blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:migrate:local": "pnpm --filter @kk2a/blog-api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @kk2a/blog-api db:migrate:remote",
    "sync-id-mappings": "pnpm --filter @kk2a/blog-web sync-id-mappings",
    "content:sync": "pnpm --filter @kk2a/blog-web content:sync",
    "content:edit": "pnpm --filter @kk2a/blog-web content:edit",
    "topics:migrate": "pnpm --filter @kk2a/blog-web topics:migrate",
    "prepare-content": "pnpm --filter @kk2a/blog-web prepare-content",
    "prepare-content:overwrite": "pnpm --filter @kk2a/blog-web prepare-content:overwrite",
    "create-mdx": "pnpm --filter @kk2a/blog-web create-mdx",
    "validate-mdx": "pnpm --filter @kk2a/blog-web validate-mdx",
    "dev": "pnpm --filter @kk2a/blog-web dev",
    "build": "pnpm --filter @kk2a/blog-web build",
    "start": "pnpm --filter @kk2a/blog-web start",
    "lint": "biome check .",
    "lint:eslint": "pnpm --filter @kk2a/blog-web lint:eslint",
    "types": "wrangler types apps/api/src/worker-configuration.d.ts --config wrangler.jsonc",
    "types:check": "wrangler types apps/api/src/worker-configuration.d.ts --config wrangler.jsonc --check",
    "typecheck": "pnpm --filter @kk2a/blog-web typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:scripts": "pnpm --filter @kk2a/blog-web test:scripts",
    "test": "pnpm --filter @kk2a/blog-web test && pnpm --filter @kk2a/blog-api test",
    "check": "pnpm types && pnpm types:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter @kk2a/blog-api typecheck && pnpm --filter @kk2a/blog-api db:check && pnpm validate-mdx && pnpm test",
    "deploy": "D1_DATABASE_LOCATION=remote pnpm prepare-content && pnpm build && pnpm exec wrangler deploy",
    "preview": "pnpm prepare-content && pnpm build && pnpm exec wrangler dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "wrangler": "^4.146.0"
  },
  "lint-staged": {
    "apps/web/content/**/*.mdx": [
      "pnpm --filter @kk2a/blog-web exec tsx scripts/update-mdx-metadata.ts"
    ]
  }
}
