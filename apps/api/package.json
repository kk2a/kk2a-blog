{
  "name": "@kk2a/blog-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply kk2a-blog --local --config ../../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply kk2a-blog --remote --config ../../wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
